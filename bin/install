#!/usr/bin/env sh

# Builds the sat executable and installs it into the dotfiles Stow package.
#
# Usage: bin/install [destination-dir]
#
# The destination defaults to "$DOTS_DIR/opt/sat/bin" (the same location the
# former shell scripts used). Only the single `sat` binary is installed; no
# compatibility aliases for the old command names are created.

set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
output="${1:-${DOTS_DIR:?DOTS_DIR is not set}/opt/sat/bin}"

version="$(git -C "$root" describe --tags --always --dirty 2>/dev/null || echo dev)"

mkdir -p "$output"

(
    cd "$root" &&
        go build -trimpath \
            -ldflags "-s -w -X main.version=$version" \
            -o "$output/sat" ./cmd/sat
)

echo "installed $output/sat ($version)"

if command -v stw >/dev/null 2>&1; then
    stw
fi
